# =====================================================================
# WISUALYST PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ---------------------------------------------------------------------
PROJECT_NAME="Supply Chain AI Decision-Intelligence"
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="production" # "development" or "production"
LOG_LEVEL="INFO"          # "DEBUG", "INFO", "WARNING", "ERROR"

# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Local Persistent SQLite Database (Default):
DATABASE_URL="sqlite:////app/data/supply_chain.db"

# Production PostgreSQL Database (Uncomment when connecting to RDS / Live Postgres):
# DATABASE_URL="postgresql://postgres:YourPassword@your-postgres-host:5432/supply_chain_db"

# ---------------------------------------------------------------------
# 3. GENAI / LLM API PROVIDER CONFIGURATION
# ---------------------------------------------------------------------
# Active AI Provider Options: "openai", "claude", or "rule_based"
AI_PROVIDER="openai"

# OpenAI API Key (For GPT-4o powered conversational intelligence):
OPENAI_API_KEY=""

# Anthropic API Key (For Claude 3.5 Sonnet powered conversational intelligence):
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------
# 4. AWS DEPLOYMENT CREDENTIALS (EC2 & Infrastructure Scripts)
# ---------------------------------------------------------------------
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID_HERE"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY_HERE"
AWS_REGION="ap-south-1"

# ---------------------------------------------------------------------
# 5. FRONTEND API ROUTING (React / Vite)
# ---------------------------------------------------------------------
# Leave blank ("") in production so Nginx reverse proxy routes /api/ requests
# Set to "http://localhost:8000" only when running npm run dev locally
VITE_API_BASE_URL=""
